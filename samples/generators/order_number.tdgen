# Datenschmiede Generator
name = "order_number"
description = """
Fortlaufende **Bestellnummern** mit konfigurierbarem Präfix und Startwert,
z. B. `ORD-000123`. Beispiel für einen benutzerdefinierten Generator
(.tdgen): die Parameter unten werden je Spalte im Table Editor gesetzt,
der Python-Code läuft beim Generator-Lauf.
"""

[[parameters]]
name = "prefix"
type = "string"
description = "Fester Präfix vor der laufenden Nummer, z. B. \"ORD-\"."
required = true

[[parameters]]
name = "start"
type = "integer"
description = "Erster Zahlenwert (Standard 1)."

[[parameters]]
name = "digits"
type = "string"
description = "Anzahl Stellen mit führenden Nullen."
choices = ["4", "6", "8"]

[code]
generate = """
prefix = params.get("prefix", "")
start = params.get("start", 1)
digits = params.get("digits", 6)
numbers = ctx.np.arange(start, start + n)
return ctx.pd.Series([f"{prefix}{num:0{digits}d}" for num in numbers])
"""
parse_params = """
return {
    "prefix": params.get("prefix", ""),
    "start": int(params.get("start", "") or 1),
    "digits": int(params.get("digits", "") or 6),
}
"""
display_value = """
return f"{params.get('prefix', '')}{int(params.get('start', '') or 1):0{int(params.get('digits', '') or 6)}d}…"
"""
