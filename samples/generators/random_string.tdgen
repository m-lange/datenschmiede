# Datenschmiede Generator
name = "random_string"
description = """
**Zufällige Strings** mit konfigurierbarer Länge, z. B. für Codes oder
IDs. Der Zeichenvorrat ist frei wählbar (Standard: Kleinbuchstaben) —
vektorisiert über numpy, damit auch große Datenmengen schnell entstehen.
"""

[[parameters]]
name = "length"
type = "integer"
description = "Länge jedes erzeugten Strings."
required = true

[[parameters]]
name = "chars"
type = "string"
description = "Zeichenvorrat, aus dem gezogen wird (leer = Kleinbuchstaben a–z)."

[code]
generate = """
length = params.get("length", 10)
chars = params.get("chars") or "abcdefghijklmnopqrstuvwxyz"
alphabet = ctx.np.array(list(chars))
indices = ctx.rng.integers(0, len(alphabet), size=(n, length))
return ctx.pd.Series(["".join(row) for row in alphabet[indices]])
"""
parse_params = """
return {
    "length": int(params.get("length", "") or 10),
    "chars": params.get("chars", ""),
}
"""
display_value = """
return f"random_string({params.get('length', '?')})"
"""
