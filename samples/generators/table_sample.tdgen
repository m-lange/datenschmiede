# Datenschmiede Generator
name = "table_sample"
description = """
Zieht **zufällige Werte aus einer Spalte einer anderen Tabelle** und stellt
optional einen festen Präfix voran. Beispiel für einen benutzerdefinierten
Generator mit Tabellen-/Spalten-Referenz: die referenzierte Tabelle wird im
Projekt automatisch mit ausgewählt und beim Lauf **vor** dieser Tabelle
generiert (ctx.table liefert ihre bereits erzeugten Werte).
"""

[[parameters]]
name = "source_table"
type = "table"
description = "Tabelle, aus deren Werten gezogen wird."
required = true

[[parameters]]
name = "source_column"
type = "column"
description = "Spalte der referenzierten Tabelle."
required = true

[[parameters]]
name = "prefix"
type = "string"
description = "Fester Präfix vor jedem Wert (optional)."

[code]
generate = """
values = ctx.table(params["source_table"], params["source_column"])
picks = ctx.rng.choice(ctx.np.array(list(values), dtype=object), size=n)
prefix = params.get("prefix", "")
if prefix:
    return ctx.pd.Series([f"{prefix}{value}" for value in picks])
return ctx.pd.Series(picks)
"""
parse_params = """
return params
"""
display_value = """
return f"{params.get('source_table', '?')}.{params.get('source_column', '?')}"
"""
