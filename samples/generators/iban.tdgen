# Datenschmiede Generator
name = "iban"
description = """
Erzeugt **zufällige IBANs mit gültigen Prüfziffern** (ISO 7064, mod 97-10)
— z. B. `DE44370400440532013000`. Die Kontonummern sind frei erfunden,
aber jede IBAN besteht jede Prüfziffern-Validierung: ideal, um
IBAN-Prüflogik mit realistischen Testdaten zu füttern.

**Parameter:**

- `country` *(Pflicht)*: Ländercode — vordefinierte Auswahl `DE`/`AT`/`CH`,
  bestimmt die Länge der BBAN (DE 18, AT 16, CH 17 Stellen)
- `bank_code`: feste Bankleitzahl am BBAN-Anfang (z. B. `37040044`) —
  leer lassen für eine zufällige Bank je Datensatz
- `formatted`: `true` gruppiert die Ausgabe in Viererblöcke
  (`DE44 3704 0044 …`)

**Was dieses Beispiel zeigt:**

- eine **Hilfsfunktion im `generate`-Rumpf** (`check_digits`) — der Rumpf
  ist normales Python, auch `def` ist erlaubt
- Parameter mit fester Werteliste (`choices`), optionalem Freitext und
  vom Typ **`boolean`**
- die **`validate`-Zelle** prüft `bank_code` (nur Ziffern, kürzer als die
  BBAN) — Warnungen erscheinen an der konfigurierten Spalte in der
  Problems-Ansicht
"""

[[parameters]]
name = "country"
type = "string"
description = "Ländercode der IBAN — bestimmt die BBAN-Länge."
choices = ["DE", "AT", "CH"]
required = true

[[parameters]]
name = "bank_code"
type = "string"
description = "Feste Bankleitzahl am BBAN-Anfang; leer = zufällige Bank je Datensatz."
placeholder = "37040044"

[[parameters]]
name = "formatted"
type = "boolean"
description = "true = Ausgabe in Viererblöcken mit Leerzeichen (DE44 3704 …)."

[code]
generate = """
country = (params.get("country") or "DE").strip().upper()
bban_length = {"DE": 18, "AT": 16, "CH": 17}.get(country, 18)
bank = (params.get("bank_code") or "").strip()
random_digits = max(0, bban_length - len(bank))
blocks = ctx.rng.integers(0, 10, size=(n, random_digits))
bbans = [(bank + "".join(map(str, row)))[:bban_length] for row in blocks]

def check_digits(bban):
    # ISO 7064 (mod 97-10): BBAN + Ländercode + "00", Buchstaben als
    # Zahlen (A=10 … Z=35), Prüfziffern = 98 - (Wert mod 97).
    numeric = "".join(str(int(c, 36)) for c in bban + country + "00")
    return f"{98 - int(numeric) % 97:02d}"

ibans = [f"{country}{check_digits(bban)}{bban}" for bban in bbans]
if (params.get("formatted") or "") == "true":
    ibans = [" ".join(iban[i:i + 4] for i in range(0, len(iban), 4)) for iban in ibans]
return ctx.pd.Series(ibans)
"""
parse_params = """
return params
"""
display_value = """
country = (params.get("country") or "DE").strip().upper()
length = {"DE": 22, "AT": 20, "CH": 21}.get(country, 22)
return f"IBAN {country} ({length} Stellen)"
"""
validate = """
warnings = []
country = (params.get("country") or "DE").strip().upper()
if country not in ("DE", "AT", "CH"):
    warnings.append("country must be DE, AT or CH")
bank = (params.get("bank_code") or "").strip()
if bank and not bank.isdigit():
    warnings.append("bank_code must contain digits only")
bban_length = {"DE": 18, "AT": 16, "CH": 17}.get(country, 18)
if bank.isdigit() and len(bank) >= bban_length:
    warnings.append(f"bank_code must be shorter than {bban_length} digits")
return warnings
"""
