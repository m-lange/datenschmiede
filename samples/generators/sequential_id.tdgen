# Datenschmiede Generator
name = "sequential_id"
description = """
Erzeugt **fortlaufende, eindeutige Kennungen** mit festem Präfix und
führenden Nullen — z. B. `CUST-000001`, `ORD-001000` oder `SKU-0042`.
Gedacht für Primärschlüssel und fachliche Nummernkreise, bei denen die
Werte lesbar und sortierbar sein sollen (anders als zufällige UUIDs).

**Parameter:**

- `prefix` *(Pflicht)*: fester Text vor der Nummer, z. B. `ORD-`
- `start`: erster Zahlenwert des Nummernkreises (Standard `1`)
- `digits`: Stellenanzahl mit führenden Nullen — vordefinierte Auswahl
  `4`/`6`/`8`, zeigt einen Parameter mit **fester Werteliste**

**Was dieses Beispiel zeigt:**

- `parse_params` wandelt die String-Werte aus dem Table Editor in `int` um,
  bevor `generate` läuft
- `generate` arbeitet vektorisiert über `ctx.np.arange` — auch bei
  Millionen Datensätzen schnell
- `display_value` liefert eine kompakte Zusammenfassung wie `ORD-001000…`
  für Lauf-Protokoll und Vorschau
"""

[[parameters]]
name = "prefix"
type = "string"
description = "Fester Präfix vor der laufenden Nummer, z. B. \"ORD-\"."
required = true

[[parameters]]
name = "start"
type = "integer"
description = "Erster Zahlenwert des Nummernkreises (Standard 1)."

[[parameters]]
name = "digits"
type = "string"
description = "Anzahl Stellen mit führenden Nullen."
choices = ["4", "6", "8"]

[code]
generate = """
prefix = params.get("prefix", "")
start = params.get("start", 1)
digits = params.get("digits", 6)
numbers = ctx.np.arange(start, start + n)
return ctx.pd.Series([f"{prefix}{num:0{digits}d}" for num in numbers])
"""
parse_params = """
return {
    "prefix": params.get("prefix", ""),
    "start": int(params.get("start", "") or 1),
    "digits": int(params.get("digits", "") or 6),
}
"""
display_value = """
return f"{params.get('prefix', '')}{int(params.get('start', '') or 1):0{int(params.get('digits', '') or 6)}d}…"
"""
