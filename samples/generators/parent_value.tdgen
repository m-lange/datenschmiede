# Datenschmiede Generator
name = "parent_value"
description = """
**Übernimmt einen Wert aus der führenden (referenzierten) Tabelle** —
zeilengenau je Datensatz: für jede Zeile dieser Tabelle wird über eine
FK-Spalte *genau der* zugehörige Datensatz der referenzierten Tabelle
bestimmt und dessen Spaltenwert übernommen (ein Join, keine
Zufallsstichprobe). Beispiel: jede Bestellung bekommt das **Land ihres
Kunden**.

**Parameter:**

- `fk_column` *(Pflicht)*: FK-Spalte **dieser** Tabelle (Parametertyp
  `own_column`), über die der zugehörige Datensatz bestimmt wird —
  z. B. `customer_id`
- `via` *(optional)*: setzt den Weg über **mehrere Tabellen** fort —
  Punkt-getrennte FK-Spalten der jeweils erreichten Tabelle. Beispiel in
  `shipments`: `fk_column` = `order_id`, `via` = `customer_id` → Sendung
  → Bestellung → **Kunde**
- `source_column` *(Pflicht)*: Spaltenname in der zuletzt erreichten
  Tabelle, dessen Wert übernommen wird — z. B. `country`

**Was dieses Beispiel zeigt:**

- `ctx.related("fk_spalte", "spalte")`: zeilengenau zugeordnete Werte der
  referenzierten Tabelle (Join über `fk_table`/`fk_column` der FK-Spalte)
  — im Gegensatz zu `ctx.table(...)`, das *alle* Werte liefert und für
  Zufallsstichproben gedacht ist
- der FK-Pfad darf **mehrstufig** sein
  (`ctx.related("order_id.customer_id", "country")`) — jede Stufe ist
  eine FK-Spalte der zuvor erreichten Tabelle
- die führenden Tabellen sind über die FK-Ketten ohnehin Teil des
  Projekts und werden vor dieser Tabelle generiert
"""

[[parameters]]
name = "fk_column"
type = "own_column"
description = "FK-Spalte dieser Tabelle, über die der zugehörige Datensatz der referenzierten Tabelle bestimmt wird."
required = true

[[parameters]]
name = "via"
type = "string"
description = "Optional: weiterer FK-Pfad, Punkt-getrennt — z. B. \"customer_id\" für Sendung → Bestellung → Kunde."

[[parameters]]
name = "source_column"
type = "string"
description = "Spaltenname in der zuletzt erreichten Tabelle, dessen Wert übernommen wird (z. B. \"country\")."
required = true

[code]
generate = """
path = params["fk_column"]
via = (params.get("via") or "").strip()
if via:
    path = f"{path}.{via}"
return ctx.related(path, params["source_column"])
"""
parse_params = """
return params
"""
display_value = """
path = params.get("fk_column", "?")
if (params.get("via") or "").strip():
    path = f"{path}.{params['via'].strip()}"
return f"{path} → {params.get('source_column', '?')}"
"""
